---
/**
 * The site mark: a skeletal aromatic ring — the single most universal glyph in
 * Ricardo's field, drawn precisely rather than decoratively.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <polygon
    points="12,3 4.21,7.5 4.21,16.5 12,21 19.79,16.5 19.79,7.5"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"></polygon>
  <circle cx="12" cy="12" r="4.4" stroke="var(--accent)" stroke-width="1.2"></circle>
</svg>
