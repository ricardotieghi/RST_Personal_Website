---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import FilterPills from './FilterPills.astro';
import { publicationGroups, publications, publicationTopics } from '../data';
import { authorsToHtml, linkLabel } from '../utils/format';

const figures = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/papers/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const options = [
  { value: 'all', label: 'All', count: publications.length },
  ...publicationTopics.map((t) => ({ value: t.id, label: t.label, count: t.count })),
];
---

<Section
  id="publications"
  label="Publications"
  title="Everything, including the work still in flight."
  count={publications.length}
  lede="Peer-reviewed papers first, then the preprint and the manuscripts under review or in preparation. Citation counts come from Google Scholar."
>
  <div class="pubs__controls">
    <FilterPills group="pubs" legend="Topic" options={options} />
    <p class="pubs__status" data-filter-status="pubs" role="status" aria-live="polite"></p>
  </div>

  <div class="pubs" data-filter-items="pubs">
    {
      publicationGroups.map((group) => (
        <div class="pubgroup" data-filter-block>
          <h3 class="pubgroup__label">
            {group.label}
            <span class="pubgroup__count">{group.items.length}</span>
          </h3>

          <ol class="pubgroup__list">
            {group.items.map((pub) => {
              const figure = pub.image ? figures[`../assets/papers/${pub.image}`] : undefined;
              return (
              <li class="pub" data-tags={pub.topics.join(' ')}>
                <div class="pub__main">
                  <h4 class="pub__title">
                    {pub.url ? (
                      <a href={pub.url} target="_blank" rel="noopener noreferrer">
                        {pub.title}
                      </a>
                    ) : (
                      pub.title
                    )}
                  </h4>

                  <p class="pub__authors" set:html={authorsToHtml(pub.authors)} />

                  <p class="pub__meta">
                    {pub.venue && <span class="pub__venue">{pub.venue}</span>}
                    {pub.year && <span>{pub.year}</span>}
                    {pub.impactFactor && <span>IF {pub.impactFactor}</span>}
                    {pub.coFirst && <span class="pub__cofirst">Co-first author</span>}
                  </p>

                  {pub.note && <p class="pub__note">{pub.note}</p>}

                  {pub.badges && (
                    <ul class="pub__badges">
                      {pub.badges.map((badge) => (
                        <li class="chip chip--award">{badge}</li>
                      ))}
                    </ul>
                  )}
                </div>

                {figure && (
                  <a
                    class="pub__figure"
                    href={pub.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <Image
                      src={figure.default}
                      alt=""
                      widths={[160, 320]}
                      sizes="8rem"
                      loading="lazy"
                    />
                  </a>
                )}

                <div class="pub__aside">
                  {pub.citations !== undefined && (
                    <p class="pub__cites">
                      <span class="pub__cites-num">{pub.citations}</span>
                      <span class="pub__cites-label">
                        {pub.citations === 1 ? 'citation' : 'citations'}
                      </span>
                    </p>
                  )}
                  {pub.url && (
                    <a
                      class="pub__link"
                      href={pub.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {linkLabel(pub.url)}
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </li>
              );
            })}
          </ol>
        </div>
      ))
    }
  </div>

  <p class="pubs__empty" data-filter-empty="pubs" hidden>
    No publications match that topic yet.
  </p>
</Section>

<style>
  .pubs__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block-end: var(--space-m);
    border-block-end: 1px solid var(--tan);
  }

  .pubs__status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    white-space: nowrap;
  }

  .pubgroup {
    padding-block-start: var(--space-l);
  }

  .pubgroup__label {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pubgroup__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.4em;
    padding: 0.1em 0.35em;
    border-radius: 999px;
    background: var(--tan);
    color: #5b4a3d;
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .pubgroup__list {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-s);
  }

  /* Three columns, explicitly placed. The middle one holds the figure and
     collapses to zero on the rows that have none, so every title still starts
     at the same left edge. */
  .pub {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 9rem;
    gap: var(--space-m);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--tan);
  }

  .pub__main {
    grid-column: 1;
  }
  .pub__figure {
    grid-column: 2;
  }
  .pub__aside {
    grid-column: 3;
  }

  /* Decorative duplicate of the title link — hidden from assistive tech and
     skipped by the keyboard, so it adds no extra tab stop. */
  .pub__figure {
    display: block;
    width: 8rem;
    align-self: start;
    border: 1px solid var(--tan);
    border-radius: 2px;
    background: var(--surface);
    padding: 0.25rem;
    transition: border-color 0.15s var(--ease);
  }

  .pub__figure:hover {
    border-color: var(--blue-soft);
  }

  .pub__figure :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }

  .pub:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .pub__title {
    font-size: var(--step-1);
    line-height: 1.28;
    font-weight: 600;
  }

  .pub__title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--blue-soft), var(--blue-soft));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size 0.25s var(--ease), color 0.15s var(--ease);
  }

  .pub__title a:hover {
    color: var(--accent-hover);
    background-size: 100% 2px;
  }

  .pub__authors {
    margin-block-start: 0.35rem;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .pub__authors :global(.self) {
    color: var(--ink);
    font-weight: 600;
  }

  .pub__meta {
    margin-block-start: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .pub__meta > * + *::before {
    content: '· ';
  }

  .pub__venue {
    color: var(--accent);
  }

  .pub__cofirst {
    color: var(--body);
  }

  .pub__note {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    color: var(--body);
    max-width: var(--measure);
    border-inline-start: 2px solid var(--tan-deep);
    padding-inline-start: var(--space-2xs);
  }

  .pub__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin-block-start: 0.6rem;
  }

  .pub__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2xs);
    text-align: right;
  }

  .pub__cites {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
  }

  .pub__cites-num {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 48;
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .pub__cites-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-block-start: 0.2rem;
  }

  .pub__link {
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    border-block-end: 1px solid var(--tan-deep);
    white-space: nowrap;
  }

  .pub__link:hover {
    border-block-end-color: var(--accent);
  }

  .pubs__empty {
    padding-block: var(--space-l);
    color: var(--muted);
  }

  @media (max-width: 45rem) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }

    .pub__main,
    .pub__figure,
    .pub__aside {
      grid-column: 1;
    }

    .pub__figure {
      width: 100%;
      max-width: 14rem;
      margin-block-start: var(--space-2xs);
    }

    .pub__aside {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: var(--space-s);
      text-align: left;
    }

    .pub__cites {
      flex-direction: row;
      align-items: baseline;
      gap: 0.35em;
    }

    .pub__cites-num {
      font-size: var(--step-0);
    }

    .pub__cites-label {
      margin-block-start: 0;
    }
  }
</style>
