---
import Section from './Section.astro';
import { newsSorted } from '../data';
import { hostOf } from '../utils/format';
---

<Section
  id="news"
  label="News & media"
  title="Where the work turned up elsewhere."
  count={newsSorted.length}
  lede="Coverage from NIH, NIEHS, the Society of Toxicology, and ESTIV — plus one piece written for a data science audience."
  band
>
  <ul class="news">
    {
      newsSorted.map((item) => (
        <li class="news__item">
          <a class="news__link" href={item.url} target="_blank" rel="noopener noreferrer">
            <span class="news__date">
              <time datetime={item.date.toISOString().slice(0, 10)}>{item.dateLabel}</time>
            </span>

            <span class="news__body">
              <span class="news__title">{item.title}</span>
              <span class="news__source">
                {item.source}
                {item.byline && <span class="news__byline">Written by Ricardo</span>}
              </span>
            </span>

            <span class="news__host">
              {hostOf(item.url)}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .news {
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--tan);
  }

  .news__item {
    border-block-end: 1px solid var(--tan);
  }

  .news__link {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-s);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s var(--ease);
  }

  .news__link:hover {
    background: color-mix(in srgb, var(--blue-wash) 70%, transparent);
  }

  .news__date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .news__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .news__title {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
    text-wrap: pretty;
  }

  .news__link:hover .news__title {
    color: var(--accent-hover);
  }

  .news__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .news__byline {
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--tan);
    color: #5b4a3d;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .news__host {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 48rem) {
    .news__link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'date host'
        'body body';
      gap: 0.35rem var(--space-s);
    }

    .news__date {
      grid-area: date;
    }
    .news__body {
      grid-area: body;
    }
    .news__host {
      grid-area: host;
      justify-self: end;
    }
  }
</style>
