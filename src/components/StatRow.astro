---
import { stats } from '../data';

/**
 * Srijit-style inline metrics. Every count except the Scholar figures is
 * derived from the YAML files, so the numbers cannot drift from the lists
 * further down the page.
 */
const items = [
  { value: stats.peerReviewed, label: 'Peer-reviewed', href: '#publications' },
  { value: stats.citations, label: 'Citations', href: stats.scholarUrl, external: true },
  { value: stats.hIndex, label: 'h-index', href: stats.scholarUrl, external: true },
  { value: stats.awards, label: 'Awards', href: '#awards' },
  { value: stats.talks, label: 'Invited talks', href: '#talks' },
  { value: stats.posters, label: 'Posters', href: '#talks' },
];
---

<div class="statrow">
  <div class="wrap">
    <dl class="statrow__list">
      {
        items.map((item) => (
          <div class="stat">
            <dt class="stat__label">{item.label}</dt>
            <dd class="stat__value">
              <a
                href={item.href}
                class="stat__link"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.value}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="statrow__note">
      Scholar metrics updated {stats.updated} ·
      <a href={stats.scholarUrl} target="_blank" rel="noopener noreferrer">
        Google Scholar profile
      </a>
    </p>
  </div>
</div>

<style>
  .statrow {
    border-block: 1px solid var(--tan);
    background: var(--surface);
    padding-block: var(--space-l);
  }

  .statrow__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: var(--space-m) var(--space-s);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse; /* value above label, label first in DOM */
    gap: 0.15rem;
  }

  .stat__value {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 72;
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .stat__link {
    color: inherit;
    text-decoration: none;
    border-block-end: 2px solid transparent;
    transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
  }

  .stat__link:hover {
    color: var(--accent-hover);
    border-block-end-color: var(--blue-soft);
  }

  .stat__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .statrow__note {
    margin-block-start: var(--space-m);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
