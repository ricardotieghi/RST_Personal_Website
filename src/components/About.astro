---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import graduation from '../assets/photos/graduation.jpg';
import { site } from '../data';
---

<Section id="about" label="About" title="From structure to prediction to policy.">
  <div class="about">
    <div class="about__prose">
      {site.about.map((paragraph) => <p>{paragraph}</p>)}

      <dl class="about__facts">
        {
          site.education.map((entry) => (
            <div class="fact">
              <dt class="fact__key">{entry.period}</dt>
              <dd class="fact__value">
                <strong>{entry.degree}</strong>
                <span>{entry.institution}</span>
                {entry.detail && <span class="fact__detail">{entry.detail}</span>}
              </dd>
            </div>
          ))
        }
        {
          site.skills.map((group) => (
            <div class="fact">
              <dt class="fact__key">{group.group}</dt>
              <dd class="fact__value">
                <ul class="fact__tags">
                  {group.items.map((item) => (
                    <li class="chip chip--tan">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="about__figure">
      <Image
        src={graduation}
        alt="Ricardo Scheufen Tieghi at his UNC-Chapel Hill graduation"
        widths={[320, 480, 640]}
        sizes="(max-width: 55rem) 80vw, 20rem"
        loading="lazy"
        class="about__img"
      />
      <figcaption>UNC-Chapel Hill, May 2025</figcaption>
    </figure>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }

  .about__prose p {
    max-width: var(--measure);
  }

  .about__prose p + p {
    margin-block-start: var(--space-s);
  }

  .about__facts {
    margin-block-start: var(--space-l);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--tan);
    display: grid;
    gap: var(--space-m);
  }

  .fact {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-s);
  }

  .fact__key {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    padding-block-start: 0.3em;
  }

  .fact__value {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .fact__detail {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .fact__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
  }

  .about__figure {
    position: sticky;
    top: calc(var(--header-h) + var(--space-m));
  }

  .about__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--tan);
  }

  .about__figure figcaption {
    margin-block-start: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 55rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__figure {
      position: static;
      max-width: 18rem;
    }

    .fact {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }

    .fact__key {
      padding-block-start: 0;
    }
  }
</style>
