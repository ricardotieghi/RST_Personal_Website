---
import Section from './Section.astro';
import PaperThumb from './PaperThumb.astro';
import { featuredPublications } from '../data';
import { authorsToHtml, linkLabel } from '../utils/format';
---

<Section
  id="research"
  label="Featured research"
  title="Four papers that carry the argument."
  count={featuredPublications.length}
  lede="Each one replaces an animal test with a model a regulator can actually use — or explains to policymakers why that matters."
  band
>
  <ul class="cards">
    {
      featuredPublications.map((pub) => (
        <li class="card">
          <PaperThumb
            venue={pub.venue}
            year={pub.year}
            image={pub.image}
            alt={`Figure from ${pub.title}`}
          />

          <div class="card__body">
            {/* The placeholder cover already names the venue and year. Only
                repeat them here once a real figure replaces it. */}
            {pub.image && (
              <p class="card__venue">
                <span class="chip">{pub.venue}</span>
                {pub.year && <span class="card__year">{pub.year}</span>}
              </p>
            )}

            <h3 class="card__title">{pub.title}</h3>

            <p class="card__authors" set:html={authorsToHtml(pub.authors)} />

            {pub.badges && (
              <ul class="card__badges">
                {pub.badges.map((badge) => (
                  <li class="chip chip--award">{badge}</li>
                ))}
              </ul>
            )}

            {pub.url && (
              <a class="card__link" href={pub.url} target="_blank" rel="noopener noreferrer">
                {linkLabel(pub.url)}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-m);
    list-style: none;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--tan);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease),
      transform 0.18s var(--ease);
  }

  .card:hover {
    border-color: var(--blue-soft);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-s);
    flex: 1;
  }

  .card__venue {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    flex-wrap: wrap;
  }

  .card__year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  /* Smaller than the publication list: these titles sit in a 15rem column, so
     display type at --step-1 would break into six lines. */
  .card__title {
    font-size: 1.0625rem;
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 28;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .card__authors {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .card__authors :global(.self) {
    color: var(--ink);
    font-weight: 600;
  }

  .card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
  }

  .card__link {
    margin-block-start: auto;
    padding-block-start: var(--space-2xs);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    align-self: flex-start;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    border-block-end: 1px solid var(--tan-deep);
  }

  .card__link:hover {
    border-block-end-color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
