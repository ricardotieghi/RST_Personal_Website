---
import BondRule from './BondRule.astro';

/**
 * Shared section shell. The heading is the plain section name; an optional
 * item count sits beside it so a reader knows how long a list is before
 * scrolling it — `Publications 13`.
 */
interface Props {
  id: string;
  title: string;
  count?: number;
  band?: boolean;
  narrow?: boolean;
}

const { id, title, count, band = false, narrow = false } = Astro.props;
---

<section id={id} class:list={['section', { 'section--band': band }]}>
  <div class:list={[narrow ? 'wrap-narrow' : 'wrap']}>
    <div class="section__head">
      <h2 class="section__title">
        {title}
        {
          count !== undefined && (
            <span class="section__count">
              <span class="visually-hidden">, </span>
              {count}
              <span class="visually-hidden"> {count === 1 ? 'item' : 'items'}</span>
            </span>
          )
        }
      </h2>
      <BondRule class="section__rule" />
    </div>
    <slot />
  </div>
</section>

<style>
  .section__title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  .section__count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .section__rule {
    margin-block-start: 0.35rem;
  }
</style>
