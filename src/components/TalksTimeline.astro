---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import FilterPills from './FilterPills.astro';
import { timeline, talks, posters } from '../data';

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const kindLabels: Record<string, string> = {
  talk: 'Talk',
  workshop: 'Workshop',
  webinar: 'Webinar',
  poster: 'Poster',
};

const countBy = (fn: (t: (typeof timeline)[number]) => boolean) => timeline.filter(fn).length;

const statusOptions = [
  { value: 'all', label: 'All', count: timeline.length },
  { value: 'upcoming', label: 'Upcoming', count: countBy((t) => Boolean(t.upcoming)) },
  { value: 'completed', label: 'Completed', count: countBy((t) => !t.upcoming) },
];

const typeOptions = [
  { value: 'all', label: 'All' },
  { value: 'talk', label: 'Talks', count: countBy((t) => t.kind === 'talk') },
  { value: 'workshop', label: 'Workshops', count: countBy((t) => t.kind === 'workshop') },
  { value: 'webinar', label: 'Webinars', count: countBy((t) => t.kind === 'webinar') },
  { value: 'poster', label: 'Posters', count: posters.length },
];
---

<Section
  id="talks"
  label="Talks & workshops"
  title="Where the work gets argued in person."
  count={timeline.length}
  lede={`${talks.length} invited talks and ${posters.length} conference posters, from Salt Lake City to Rio de Janeiro. Two continuing-education courses are already booked for 2026 and 2027.`}
  band
>
  <div class="talks__controls" data-filter-group="talks" data-filter-mode="and">
    <FilterPills
      group="talks"
      legend="Status"
      options={statusOptions}
      dimension="status"
      standalone
    />
    <FilterPills group="talks" legend="Type" options={typeOptions} dimension="kind" standalone />
  </div>

  <p class="talks__status" data-filter-status="talks" role="status" aria-live="polite"></p>

  <ol class="timeline" data-filter-items="talks">
    {
      timeline.map((item) => {
        const photo = item.image ? photos[`../assets/photos/${item.image}`] : undefined;
        return (
          <li
            class="event"
            data-tags={`${item.kind} ${item.upcoming ? 'upcoming' : 'completed'}`}
          >
            <div class="event__when">
              <time datetime={item.date.toISOString().slice(0, 10)}>{item.dateLabel}</time>
            </div>

            <div class="event__marker" aria-hidden="true">
              <span class:list={['event__dot', { 'event__dot--next': item.upcoming }]} />
            </div>

            <div class="event__body">
              <p class="event__tags">
                <span class="chip">{kindLabels[item.kind]}</span>
                {item.upcoming && <span class="chip chip--tan">Upcoming</span>}
                {item.award && <span class="chip chip--award">{item.award}</span>}
              </p>

              <h3 class="event__title">{item.title}</h3>

              <p class="event__where">
                <strong>{item.event}</strong>
                <span aria-hidden="true"> · </span>
                <span>{item.location}</span>
              </p>

              {item.url && (
                <a
                  class="event__link"
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.urlLabel ?? 'View'}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            {photo && (
              <Image
                src={photo.default}
                alt={`${item.event}, ${item.location}`}
                widths={[180, 320]}
                sizes="9rem"
                loading="lazy"
                class="event__photo"
              />
            )}
          </li>
        );
      })
    }
  </ol>

  <p class="talks__empty" data-filter-empty="talks" hidden>
    Nothing matches that combination. Try widening the filters.
  </p>
</Section>

<style>
  .talks__controls {
    display: grid;
    gap: var(--space-2xs);
    padding-block-end: var(--space-m);
    border-block-end: 1px solid var(--tan);
  }

  .talks__status {
    padding-block-start: var(--space-s);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-s);
  }

  .event {
    display: grid;
    grid-template-columns: 8.5rem 1.5rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-s);
    padding-block: var(--space-m);
  }

  .event__when {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    padding-block-start: 0.35rem;
    white-space: nowrap;
  }

  /* The connector line lives on the marker column so it survives filtering. */
  .event__marker {
    position: relative;
    align-self: stretch;
    display: grid;
    justify-items: center;
  }

  .event__marker::before {
    content: '';
    position: absolute;
    /* Overhang by the row padding so consecutive rows join into one line. */
    top: calc(-1 * var(--space-m));
    bottom: calc(-1 * var(--space-m));
    width: 1px;
    background: var(--tan-deep);
  }

  /* The filter script tags the first and last *visible* rows, so the line
     starts and stops at a dot no matter what is filtered out. */
  .event[data-edge-first] .event__marker::before {
    top: 1rem;
  }

  .event[data-edge-last] .event__marker::before {
    bottom: calc(100% - 1.6rem);
  }

  .event__dot {
    position: relative;
    margin-block-start: 0.6rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--canvas-deep);
    border: 1.5px solid var(--tan-deep);
  }

  .event__dot--next {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue-soft) 35%, transparent);
  }

  .event__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-block-end: 0.4rem;
  }

  .event__title {
    font-size: var(--step-1);
    line-height: 1.28;
    text-wrap: pretty;
  }

  .event__where {
    margin-block-start: 0.25rem;
    font-size: 0.9rem;
    color: var(--body);
  }

  .event__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-block-start: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    border-block-end: 1px solid var(--tan-deep);
  }

  .event__link:hover {
    border-block-end-color: var(--accent);
  }

  .event__photo {
    width: 9rem;
    height: 6rem;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--tan);
  }

  .talks__empty {
    padding-block: var(--space-l);
    color: var(--muted);
  }

  @media (max-width: 55rem) {
    .event {
      grid-template-columns: 1.25rem minmax(0, 1fr);
      grid-template-areas:
        'marker when'
        'marker body'
        'marker photo';
      gap: 0.25rem var(--space-s);
    }

    .event__marker {
      grid-area: marker;
    }
    .event__when {
      grid-area: when;
      padding-block-start: 0;
    }
    .event__body {
      grid-area: body;
      margin-block-start: 0.4rem;
    }
    .event__photo {
      grid-area: photo;
      margin-block-start: var(--space-2xs);
      width: 100%;
      max-width: 14rem;
      height: 8rem;
    }

    .event__dot {
      margin-block-start: 0.3rem;
    }
  }
</style>
